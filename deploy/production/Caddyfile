{
    admin off
    email {$ACME_EMAIL}
}

{$APP_SITE_ADDRESS} {
    encode zstd gzip

    @backend path /api/* /hubs/* /health /health/* /openapi/*
    reverse_proxy @backend api:8080 {
        header_up X-Forwarded-Proto https
    }

    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

{$UPDATE_SITE_ADDRESS} {
    root * /srv/updates

    @manifest path_regexp manifest ^/.*/release\.json$
    header @manifest Cache-Control "no-store, max-age=0"

    @packages path *.zip
    header @packages Cache-Control "public, max-age=31536000, immutable"

    header {
        -Server
        X-Content-Type-Options "nosniff"
    }

    file_server
}
