<Window x:Class="TaskMonitoring.EmployeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Workspace" Height="680" Width="960" MinHeight="620" MinWidth="880">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Employee Workspace" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Attendance, connectivity and transparent work status" Margin="0,6,0,0" Opacity="0.7" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,20,0,16" Padding="16" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Server URL" FontWeight="SemiBold" />
          <TextBox x:Name="ServerUrlBox" Margin="0,6,12,0" Text="https://localhost:5001" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Email" FontWeight="SemiBold" />
          <TextBox x:Name="EmailBox" Margin="0,6,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Password" FontWeight="SemiBold" />
          <PasswordBox x:Name="PasswordBox" Margin="0,6,12,0" />
        </StackPanel>
        <Button Grid.Column="3" x:Name="LoginButton" Content="Sign in" Width="110" Height="34" VerticalAlignment="Bottom" Click="LoginButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Padding="18" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="Attendance" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="AttendanceStatusText" Text="Sign in to load your attendance status." Margin="0,14,0,18" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Check in" Width="100" Margin="0,0,8,8" Click="CheckInButton_Click" />
            <Button Content="Start break" Width="100" Margin="0,0,8,8" Click="StartBreakButton_Click" />
            <Button Content="End break" Width="100" Margin="0,0,8,8" Click="EndBreakButton_Click" />
            <Button Content="Check out" Width="100" Margin="0,0,8,8" Click="CheckOutButton_Click" />
          </WrapPanel>
          <Button Content="Refresh status" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RefreshButton_Click" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Padding="18" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Margin="10,0,0,0">
        <StackPanel>
          <TextBlock Text="Transparency &amp; privacy" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">This client reports only approved business status to the company server. It does not record keystrokes, passwords, microphone audio, camera video, or unrelated personal files.</TextBlock>
          <TextBlock x:Name="ConnectionStatusText" Margin="0,18,0,0" Text="Server: not connected" FontWeight="SemiBold" />
          <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.75">Authentication tokens are kept in memory for this foundation build and are not written to plaintext files.</TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
