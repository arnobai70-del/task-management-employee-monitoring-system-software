# Copy to deploy/production/production.env and edit for the real environment.
# Never commit production.env or anything under deploy/production/secrets/.

# Caddy site addresses. Real production values should be public DNS names without a scheme
# (for automatic HTTPS), for example task.example.com and updates.example.com.
APP_SITE_ADDRESS=task.example.com
UPDATE_SITE_ADDRESS=updates.example.com
ACME_EMAIL=ops@example.com

# Public origins used by deployment/acceptance scripts.
APP_PUBLIC_URL=https://task.example.com
UPDATE_PUBLIC_URL=https://updates.example.com

# Host bindings. Keep 80/443 public only on the edge host/firewall.
PRODUCTION_HTTP_BIND=0.0.0.0
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_BIND=0.0.0.0
PRODUCTION_HTTPS_PORT=443

# Dedicated internal Docker network used to trust forwarded headers only from the edge proxy.
# Change this only if the CIDR conflicts with an existing Docker/VPN network on the host.
BACKEND_NETWORK_CIDR=10.77.0.0/24

# PostgreSQL identity. The password itself lives in the referenced secret file.
POSTGRES_DB=task_monitoring
POSTGRES_USER=task_monitoring

# JWT metadata. The signing key itself lives in the referenced secret file.
JWT_ISSUER=TaskMonitoring.Api
JWT_AUDIENCE=TaskMonitoring.Clients

# Paths are resolved by Docker Compose relative to deploy/production/.
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password
DATABASE_CONNECTION_SECRET_FILE=./secrets/database_connection
JWT_SIGNING_KEY_SECRET_FILE=./secrets/jwt_signing_key
AGENT_UPDATE_ENROLLMENT_KEY_SECRET_FILE=./secrets/agent_update_enrollment_key

# Update packages and release.json are served read-only by the web edge container.
UPDATE_HOST_ROOT=./updates

# Host-side PostgreSQL backups created by scripts/production/backup-postgres.sh.
BACKUP_ROOT=./backups
