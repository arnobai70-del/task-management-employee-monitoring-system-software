# Copy to .env for local Docker usage. Never commit the real .env file.
POSTGRES_DB=task_monitoring
POSTGRES_USER=task_monitoring
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# ASP.NET Core configuration uses double underscores for nested keys.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=task_monitoring;Username=task_monitoring;Password=replace-with-a-strong-local-password
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__Issuer=TaskMonitoring.Api
Jwt__Audience=TaskMonitoring.Clients
Database__AutoMigrate=true

# Optional one-time/bootstrap administrator. Use a strong unique password.
BootstrapAdmin__Email=
BootstrapAdmin__Password=
