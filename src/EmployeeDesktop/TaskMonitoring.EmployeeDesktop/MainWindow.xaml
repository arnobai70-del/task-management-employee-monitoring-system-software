<Window x:Class="TaskMonitoring.EmployeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitoring · Employee Workspace"
        Height="860" Width="1360" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- SIGN-IN EXPERIENCE -->
    <Grid x:Name="LoginShell" Grid.Row="0" Margin="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.08*" />
        <ColumnDefinition Width="0.92*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="24" Padding="44">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07111F" Offset="0" />
            <GradientStop Color="#0F274A" Offset="0.55" />
            <GradientStop Color="#1D4ED8" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal">
            <Border Width="50" Height="50" CornerRadius="14" Background="#2F6FED">
              <TextBlock Text="TM" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,2,0,0">
              <TextBlock Text="TaskMonitoring" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Employee Workspace" Foreground="#AFC4E3" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
            <Border Background="#153A66" CornerRadius="18" Padding="11,7" HorizontalAlignment="Left" Margin="0,0,0,22">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Secure organization workspace" Foreground="#DCEBFF" FontWeight="SemiBold" FontSize="11.5" />
              </StackPanel>
            </Border>
            <TextBlock Text="Everything you need for the workday, without the clutter."
                       Foreground="#FFFFFF" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="47" />
            <TextBlock Text="Attendance, assigned tasks, approved website work, surveys, notifications and company access are kept together in one focused desktop client."
                       Foreground="#B9CBE4" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,0" />

            <StackPanel Margin="0,30,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="28" Height="28" CornerRadius="8" Background="#193C67">
                  <TextBlock Text="✓" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="One workspace for tasks, attendance and assigned access" Foreground="#E7EEF9" Margin="12,5,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="28" Height="28" CornerRadius="8" Background="#193C67">
                  <TextBlock Text="✓" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Realtime work notifications and transparent monitoring status" Foreground="#E7EEF9" Margin="12,5,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#193C67">
                  <TextBlock Text="✓" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No keystroke, password, screenshot, microphone or camera capture" Foreground="#E7EEF9" Margin="12,5,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="2" Text="TaskMonitoring · employee client" Foreground="#7892B3" FontSize="11.5" />
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Border Width="450" MaxHeight="590" Style="{StaticResource ElevatedCardStyle}" Padding="36" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
              <TextBlock Text="↗" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Welcome back" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="Sign in with your organization account to open your employee workspace."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,26" />

            <TextBlock Text="SERVER" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" FontWeight="Bold" />
            <TextBox x:Name="ServerUrlBox" Text="http://127.0.0.1:5080" Margin="0,7,0,16" ToolTip="Your organization server address" />

            <TextBlock Text="EMAIL" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" FontWeight="Bold" />
            <TextBox x:Name="EmailBox" Margin="0,7,0,16" />

            <TextBlock Text="PASSWORD" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" FontWeight="Bold" />
            <PasswordBox x:Name="PasswordBox" Margin="0,7,0,22" />

            <Button x:Name="LoginButton" Content="Sign in to workspace" Style="{StaticResource PrimaryButtonStyle}" Height="46" Click="LoginButton_Click" />

            <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,20,0,0">
              <TextBlock Text="Your access and refresh tokens remain in this app process and are not written to plaintext files or logs."
                         Foreground="#667085" FontSize="11.5" TextWrapping="Wrap" LineHeight="17" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- AUTHENTICATED WORKSPACE -->
    <Grid x:Name="WorkspaceShell" Grid.Row="0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="242" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="42" Height="42" CornerRadius="12" Background="#2563EB">
                <TextBlock Text="TM" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="12,1,0,0">
                <TextBlock Text="TaskMonitoring" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Employee Workspace" Foreground="#8292AA" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="WORKSPACE" Foreground="#5F718C" FontSize="10" FontWeight="Bold" Margin="4,30,0,0" />
          </StackPanel>

          <StackPanel Grid.Row="2">
            <Border Background="#111C30" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="Connected workspace" Foreground="#D8E4F3" FontWeight="SemiBold" FontSize="11.5" />
                </StackPanel>
                <TextBlock Text="Presence sync runs while signed in" Foreground="#7F91AB" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Transparent monitoring · privacy first" Foreground="#5F718C" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
        <Grid Margin="26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Work Center" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Stay focused on today’s assigned work and organization access." Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#ECFDF3" BorderBrush="#D1FADF" BorderThickness="1" CornerRadius="18" Padding="11,7" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#12B76A" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Online" Foreground="#027A48" FontWeight="SemiBold" FontSize="11.5" />
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="18" Padding="11,7" Margin="0,0,10,0">
              <TextBlock x:Name="SessionIdentityText" Text="Employee session" Foreground="#475467" FontWeight="SemiBold" FontSize="11.5" />
            </Border>
            <Button x:Name="LogoutButton" Content="Sign out" Width="96" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Click="LogoutButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="18,10,20,18">
        <TabControl.Resources>
          <Style TargetType="TabItem" BasedOn="{StaticResource NavTabItemStyle}" />
        </TabControl.Resources>

        <TabItem Header="●  Attendance">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,8,6,8">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Today’s work session" FontSize="28" FontWeight="SemiBold" />
                  <TextBlock Text="Check in, manage breaks and keep your attendance state synchronized with the organization server."
                             Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#ECFDF3" BorderBrush="#D1FADF" BorderThickness="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                  <TextBlock Text="LIVE SESSION" Foreground="#027A48" FontWeight="Bold" FontSize="10.5" />
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.25*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Margin="0,0,10,0" Padding="24">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="46" Height="46" CornerRadius="14" Background="#ECFDF3" Margin="0,0,13,0">
                        <TextBlock Text="✓" Foreground="#039855" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Current attendance" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Server-validated work session" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,2,0,0" />
                      </StackPanel>
                    </StackPanel>

                    <Border Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,18">
                      <TextBlock x:Name="AttendanceStatusText" Text="Sign in to load your attendance status." TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    </Border>

                    <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,9" />
                    <WrapPanel>
                      <Button Content="Check in" Style="{StaticResource SuccessButtonStyle}" Width="104" Margin="0,0,8,8" Click="CheckInButton_Click" />
                      <Button Content="Start break" Width="108" Margin="0,0,8,8" Click="StartBreakButton_Click" />
                      <Button Content="End break" Width="108" Margin="0,0,8,8" Click="EndBreakButton_Click" />
                      <Button Content="Check out" Style="{StaticResource DangerButtonStyle}" Width="104" Margin="0,0,8,8" Click="CheckOutButton_Click" />
                    </WrapPanel>
                    <Button Content="Refresh status" Width="122" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RefreshAttendanceButton_Click" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Workspace connection" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock x:Name="ConnectionStatusText" Text="Server: not connected" FontWeight="SemiBold" Margin="0,14,0,0" />
                      <TextBlock x:Name="RealtimeStatusText" Text="Notifications: disconnected" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                      <TextBlock Text="Approved monitoring" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock x:Name="MonitoringStatusText" Text="Approved activity monitoring: sign in to load policy" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" />
                      <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock Text="Monitoring scope is controlled by organization policy and disclosed in the Privacy section."
                                   Foreground="#475467" FontSize="11.5" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="☷  My Tasks">
          <Grid Margin="22,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="My assigned tasks" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Project work, priority, due dates and discussion activity in one queue." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <CheckBox x:Name="IncludeClosedTasksBox" Content="Include done/cancelled" />
              </Border>
            </Grid>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <Grid>
                <TextBlock Text="Select a task row to review its current status and project context." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Content="Refresh tasks" Width="112" HorizontalAlignment="Right" Click="RefreshTasksButton_Click" />
              </Grid>
            </Border>
            <DataGrid Grid.Row="2" x:Name="TasksGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.3*" />
                <DataGridTextColumn Header="TASK" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="100" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="110" />
                <DataGridTextColumn Header="COMMENTS" Binding="{Binding CommentCount}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="◎  Website Work">
          <Grid Margin="22,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Website work queue" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Open approved work targets and mark them complete when the assigned work is finished." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="WebsiteWorkCountText" Text="0 website work item(s)" Foreground="#475467" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh work" Width="108" Margin="0,0,8,0" Click="RefreshWebsiteWorkButton_Click" />
                <Button Content="Start / Open selected" Style="{StaticResource PrimaryButtonStyle}" Width="160" Margin="0,0,8,0" Click="OpenWebsiteWorkButton_Click" />
                <Button Content="Mark complete" Style="{StaticResource SuccessButtonStyle}" Width="126" Margin="0,0,14,0" Click="CompleteWebsiteWorkButton_Click" />
                <CheckBox x:Name="IncludeClosedWebsiteWorkBox" Content="Include completed/cancelled" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="WebsiteWorkGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="TARGET" Binding="{Binding Title}" Width="1.7*" />
                <DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2*" />
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.2*" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="95" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105" />
                <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="◈  Survey Work">
          <Grid Margin="22,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Survey assignments" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Launch organization-assigned surveys without collecting form content or answers in this app." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="SurveyCountText" Text="0 survey assignment(s)" Foreground="#475467" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh surveys" Width="118" Margin="0,0,8,0" Click="RefreshSurveysButton_Click" />
                <Button Content="Open selected survey" Style="{StaticResource PrimaryButtonStyle}" Width="158" Margin="0,0,14,0" Click="OpenSurveyButton_Click" />
                <CheckBox x:Name="IncludeInactiveSurveysBox" Content="Include inactive history" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="SurveyGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SURVEY" Binding="{Binding Title}" Width="1.3*" />
                <DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2.2*" />
                <DataGridTextColumn Header="STARTS" Binding="{Binding StartsOn}" Width="105" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Availability}" Width="95" />
                <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="◉  Notifications">
          <Grid Margin="22,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Notifications" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Realtime organization updates and work-related messages." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="NotificationsCountText" Text="0 notifications" Foreground="#475467" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh" Width="92" Margin="0,0,8,0" Click="RefreshNotificationsButton_Click" />
                <Button Content="Mark selected read" Style="{StaticResource PrimaryButtonStyle}" Width="148" Margin="0,0,14,0" Click="MarkNotificationReadButton_Click" />
                <CheckBox x:Name="UnreadNotificationsOnlyBox" Content="Unread only" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="NotificationsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STATE" Binding="{Binding ReadState}" Width="80" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="130" />
                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.2*" />
                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.5*" />
                <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc}" Width="170" />
                <DataGridTextColumn Header="READ" Binding="{Binding ReadAtUtc}" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="◆  My Access">
          <Grid Margin="22,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Company-provided access" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="View assigned RDP, IP and website access without exposing managed passwords inside this client." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh access" Width="114" Margin="0,0,12,0" Click="RefreshAccessButton_Click" />
                <CheckBox x:Name="IncludeInactiveAccessBox" Content="Include inactive/released history" />
              </WrapPanel>
            </Border>
            <TabControl Grid.Row="2" TabStripPlacement="Top">
              <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SubTabItemStyle}" />
              </TabControl.Resources>
              <TabItem Header="RDP">
                <DataGrid x:Name="RdpGrid" Margin="0,12,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*" />
                    <DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="1.4*" />
                    <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="70" />
                    <DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*" />
                    <DataGridTextColumn Header="CREDENTIAL REFERENCE" Binding="{Binding CredentialReference}" Width="1.4*" />
                    <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110" />
                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="IP">
                <DataGrid x:Name="IpGrid" Margin="0,12,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" Width="1.2*" />
                    <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="1.5*" />
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.3*" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="ASSIGNED" Binding="{Binding AssignedOn}" Width="110" />
                    <DataGridTextColumn Header="RELEASED" Binding="{Binding ReleasedOn}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="Website">
                <Grid Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                    <WrapPanel>
                      <Button Content="Open selected website" Style="{StaticResource PrimaryButtonStyle}" Width="160" Margin="0,0,12,0" Click="OpenWebsiteButton_Click" />
                      <TextBlock Text="Only the approved hostname is recorded for company-assigned website launches."
                                 Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                  </Border>
                  <DataGrid Grid.Row="1" x:Name="WebsiteGrid">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*" />
                      <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                      <DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*" />
                      <DataGridTextColumn Header="ACCESS" Binding="{Binding AccessLevel}" Width="90" />
                      <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110" />
                      <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>

        <TabItem Header="▣  Privacy">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,8,6,8">
              <TextBlock Text="Transparency &amp; privacy" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Clear boundaries for what the employee client does and does not collect." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,12">
                  <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#EFF6FF" HorizontalAlignment="Left">
                      <TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Visible to authorized administrators" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Presence, last-seen and attendance-derived work state are synchronized while you are signed in.</TextBlock>
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Foreground application activity is sent only for administrator-approved application rules, and window titles only when that rule explicitly enables them.</TextBlock>
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Approved business website activity is recorded as hostname only.</TextBlock>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,12">
                  <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF3" HorizontalAlignment="Left">
                      <TextBlock Text="—" Foreground="#039855" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Never collected by this client" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">No keystrokes, passwords, screenshots, microphone audio, camera video or unrelated personal files are collected.</TextBlock>
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Browser history, URL paths, query strings, page content, form fields, cookies and survey answers are not read by this app.</TextBlock>
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">RDP and website passwords are not stored or displayed here.</TextBlock>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Current monitoring disclosure" Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="MonitoringDisclosureText" Margin="0,8,20,0" TextWrapping="Wrap" Foreground="#334155" Text="Monitoring disclosure is loaded from the company server after sign-in." />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Refresh policy" Width="120" VerticalAlignment="Center" Click="RefreshMonitoringPolicyButton_Click" />
                </Grid>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="Assigned work and survey boundaries" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Website Work records when you start/open an assigned target and when you explicitly mark it complete. The client does not inspect the external page or credentials.</TextBlock>
                  <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Opening a survey assignment records that the approved survey link was opened using hostname-only audit metadata. Survey questions and answers remain on the external survey website.</TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- STATUS BAR -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1,1,1,0" Padding="14,10">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="MessageText" Text="Ready. Sign in to connect your workspace." TextWrapping="Wrap" Foreground="#475467" FontSize="11.5" />
      </Grid>
    </Border>
  </Grid>
</Window>