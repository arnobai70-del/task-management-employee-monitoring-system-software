<Window x:Class="TaskMonitoring.EmployeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitoring · Employee Workspace"
        Height="820" Width="1380" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- SIGN IN -->
    <ScrollViewer x:Name="LoginShell"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <Grid MinHeight="600" Margin="28">
        <Border Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource ElevatedCardStyle}"
                Padding="34">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
              <Border Width="48" Height="48" CornerRadius="14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38BDF8" Offset="0" />
                    <GradientStop Color="#4F46E5" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="TM" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="13,2,0,0">
                <TextBlock Text="TaskMonitoring" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Employee Workspace" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>

            <Border Background="#EEF5FF" CornerRadius="16" Padding="14" Margin="0,0,0,22">
              <StackPanel>
                <TextBlock Text="EMPLOYEE ACCESS" Foreground="#2F6FED" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Sign in to your workspace" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                <TextBlock Text="Access attendance, assigned work, notifications and company resources."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="EMAIL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
            <TextBox x:Name="EmailBox" Margin="0,5,0,14" />
            <TextBlock Text="PASSWORD" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,18" />
            <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Height="46" Click="LoginButton_Click" />

            <Expander Header="Connection settings" Margin="0,18,0,0" Foreground="#475467">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="SERVER URL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                <TextBox x:Name="ServerUrlBox" Text="http://127.0.0.1:5080" Margin="0,5,0,0" ToolTip="Your organization server address" />
              </StackPanel>
            </Expander>

            <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#12B76A" Margin="0,4,9,0" VerticalAlignment="Top" />
                <TextBlock Text="Session tokens stay in memory and are not written to plaintext files or logs."
                           Foreground="#667085" FontSize="10.8" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- AUTHENTICATED WORKSPACE -->
    <Grid x:Name="WorkspaceShell" Grid.Row="0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- SIDEBAR -->
      <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="13">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38BDF8" Offset="0" />
                    <GradientStop Color="#4F46E5" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="TM" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="12,2,0,0">
                <TextBlock Text="TaskMonitoring" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Employee workspace" Foreground="#89A0C2" FontSize="10.5" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="WORKSPACE" Foreground="#6F86A8" FontSize="9.5" FontWeight="Bold" Margin="4,24,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Background="#0E1E36" BorderBrush="#223B60" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="Connected workspace" Foreground="#D8E4F3" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Presence sync runs while signed in" Foreground="#8195B4" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Transparent monitoring · privacy first" Foreground="#667B9C" FontSize="9.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- TOPBAR -->
      <Border Grid.Column="1" Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE4F0" BorderThickness="0,0,0,1">
        <Grid Margin="28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Employee Command Center" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Your workday, assignments and organization access in one place."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#ECFDF3" BorderBrush="#D1FADF" BorderThickness="1" CornerRadius="18" Padding="11,6" Margin="0,0,9,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#12B76A" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Online" Foreground="#027A48" FontWeight="SemiBold" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="18" Padding="11,6" Margin="0,0,9,0">
              <TextBlock x:Name="SessionIdentityText" Text="Employee session" Foreground="#475467" FontWeight="SemiBold" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button x:Name="LogoutButton" Content="Sign out" Width="92" Height="38" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Click="LogoutButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- NAV + CONTENT -->
      <TabControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                  TabStripPlacement="Left"
                  Background="Transparent"
                  BorderThickness="0"
                  Margin="18,14,24,18"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        <TabControl.Resources>
          <Style TargetType="TabItem" BasedOn="{StaticResource NavTabItemStyle}" />
        </TabControl.Resources>

        <!-- ATTENDANCE DASHBOARD -->
        <TabItem Header="●  Attendance">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
            <Grid Margin="28,4,4,18" HorizontalAlignment="Stretch">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" CornerRadius="24" Padding="28" Margin="0,0,0,18">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B2A55" Offset="0" />
                    <GradientStop Color="#2456B8" Offset="0.58" />
                    <GradientStop Color="#6547E7" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="TODAY'S WORKDAY" Foreground="#9ED8FF" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Everything you need for this session" Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Text="Attendance, live connection and approved monitoring status are visible here without switching screens."
                               Foreground="#D5E5FF" FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0" MaxWidth="760" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="#6EE7B7" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="LIVE WORKSPACE" Foreground="White" FontWeight="Bold" FontSize="10" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Padding="20" Margin="0,0,9,0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF3" Margin="0,0,12,0">
                        <TextBlock Text="✓" Foreground="#039855" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Attendance" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Current work-session state" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,15,0,0">
                      <TextBlock x:Name="AttendanceStatusText" Text="Sign in to load your attendance status." TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" LineHeight="18" />
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20" Margin="9,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="42" Height="42" CornerRadius="12" Background="#EFF6FF" Margin="0,0,12,0">
                        <TextBlock Text="↔" Foreground="#2563EB" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Connection" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Server &amp; realtime" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ConnectionStatusText" Text="Server: not connected" FontWeight="SemiBold" Margin="0,15,0,0" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock x:Name="RealtimeStatusText" Text="Notifications: disconnected" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20" Margin="9,0,0,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="42" Height="42" CornerRadius="12" Background="#F5F3FF" Margin="0,0,12,0">
                        <TextBlock Text="◈" Foreground="#6D5CE7" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Monitoring" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Organization policy" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="MonitoringStatusText" Text="Approved activity monitoring: sign in to load policy" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="11.5" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Padding="24" Margin="0,0,10,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Quick attendance actions" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Keep your session accurate with one-click workday controls." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Refresh" Width="94" Height="38" Click="RefreshAttendanceButton_Click" />
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,22,0,0">
                      <Button Content="Check in" Style="{StaticResource SuccessButtonStyle}" Height="48" Margin="0,0,7,0" Click="CheckInButton_Click" />
                      <Button Content="Start break" Height="48" Margin="7,0" Click="StartBreakButton_Click" />
                      <Button Content="End break" Height="48" Margin="7,0" Click="EndBreakButton_Click" />
                      <Button Content="Check out" Style="{StaticResource DangerButtonStyle}" Height="48" Margin="7,0,0,0" Click="CheckOutButton_Click" />
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24" Margin="10,0,0,0">
                  <StackPanel>
                    <TextBlock Text="Privacy-aware monitoring" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Only organization-approved activity rules are synchronized. The full scope is disclosed in Privacy."
                               Foreground="#475467" FontSize="11.5" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,14,0,0">
                      <TextBlock Text="No keystrokes, passwords, screenshots, microphone or camera capture." Foreground="#334155" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Width="165" VerticalAlignment="Center">
                    <TextBlock Text="WORKDAY FLOW" Foreground="#2F6FED" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Simple, visible session steps" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="16,0,6,0">
                    <StackPanel><TextBlock Text="01 · Check in" FontWeight="SemiBold"/><TextBlock Text="Start your active work session." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="6,0">
                    <StackPanel><TextBlock Text="02 · Manage breaks" FontWeight="SemiBold"/><TextBlock Text="Start and end breaks explicitly." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                  <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="03 · Check out" FontWeight="SemiBold"/><TextBlock Text="Close the work session when done." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- TASKS -->
        <TabItem Header="☷  My Tasks">
          <Grid Margin="28,4,4,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="My assigned tasks" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Project work, priorities, due dates and discussion activity in one queue." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><CheckBox x:Name="IncludeClosedTasksBox" Content="Include done/cancelled"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><Grid><TextBlock Text="Select a task row to review its current status and project context." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><Button Content="Refresh tasks" Width="112" Height="38" HorizontalAlignment="Right" Click="RefreshTasksButton_Click"/></Grid></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="TasksGrid"><DataGrid.Columns><DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.3*"/><DataGridTextColumn Header="TASK" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="100"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="110"/><DataGridTextColumn Header="COMMENTS" Binding="{Binding CommentCount}" Width="90"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <!-- WEBSITE WORK -->
        <TabItem Header="◎  Website Work">
          <Grid Margin="28,4,4,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Website work queue" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Open approved work targets and mark them complete when assigned work is finished." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="WebsiteWorkCountText" Text="0 website work item(s)" Foreground="#475467" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh work" Width="106" Height="38" Margin="0,0,8,0" Click="RefreshWebsiteWorkButton_Click"/><Button Content="Start / Open selected" Style="{StaticResource PrimaryButtonStyle}" Width="158" Height="38" Margin="0,0,8,0" Click="OpenWebsiteWorkButton_Click"/><Button Content="Mark complete" Style="{StaticResource SuccessButtonStyle}" Width="126" Height="38" Margin="0,0,14,0" Click="CompleteWebsiteWorkButton_Click"/><CheckBox x:Name="IncludeClosedWebsiteWorkBox" Content="Include completed/cancelled"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="WebsiteWorkGrid"><DataGrid.Columns><DataGridTextColumn Header="TARGET" Binding="{Binding Title}" Width="1.7*"/><DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2*"/><DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="95"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105"/><DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <!-- SURVEYS -->
        <TabItem Header="◈  Survey Work">
          <Grid Margin="28,4,4,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Survey assignments" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Launch organization-assigned surveys without collecting form content or answers in this app." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="SurveyCountText" Text="0 survey assignment(s)" Foreground="#475467" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh surveys" Width="116" Height="38" Margin="0,0,8,0" Click="RefreshSurveysButton_Click"/><Button Content="Open selected survey" Style="{StaticResource PrimaryButtonStyle}" Width="158" Height="38" Margin="0,0,14,0" Click="OpenSurveyButton_Click"/><CheckBox x:Name="IncludeInactiveSurveysBox" Content="Include inactive history"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="SurveyGrid"><DataGrid.Columns><DataGridTextColumn Header="SURVEY" Binding="{Binding Title}" Width="1.3*"/><DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2.2*"/><DataGridTextColumn Header="STARTS" Binding="{Binding StartsOn}" Width="105"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105"/><DataGridTextColumn Header="STATUS" Binding="{Binding Availability}" Width="95"/><DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <!-- NOTIFICATIONS -->
        <TabItem Header="◉  Notifications">
          <Grid Margin="28,4,4,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notifications" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Realtime organization updates and work-related messages." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="NotificationsCountText" Text="0 notifications" Foreground="#475467" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh" Width="90" Height="38" Margin="0,0,8,0" Click="RefreshNotificationsButton_Click"/><Button Content="Mark selected read" Style="{StaticResource PrimaryButtonStyle}" Width="148" Height="38" Margin="0,0,14,0" Click="MarkNotificationReadButton_Click"/><CheckBox x:Name="UnreadNotificationsOnlyBox" Content="Unread only"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="NotificationsGrid"><DataGrid.Columns><DataGridTextColumn Header="STATE" Binding="{Binding ReadState}" Width="80"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="130"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.2*"/><DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.5*"/><DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc}" Width="170"/><DataGridTextColumn Header="READ" Binding="{Binding ReadAtUtc}" Width="170"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <!-- ACCESS -->
        <TabItem Header="◆  My Access">
          <Grid Margin="28,4,4,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16"><TextBlock Text="Company-provided access" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="View assigned RDP, IP and website access without exposing managed passwords inside this client." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh access" Width="112" Height="38" Margin="0,0,14,0" Click="RefreshAccessButton_Click"/><CheckBox x:Name="IncludeInactiveAccessBox" Content="Include inactive/released history"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="14">
              <TabControl TabStripPlacement="Top" Background="Transparent" BorderThickness="0">
                <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SubTabItemStyle}"/></TabControl.Resources>
                <TabItem Header="RDP"><DataGrid x:Name="RdpGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="1.4*"/><DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="70"/><DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*"/><DataGridTextColumn Header="CREDENTIAL REFERENCE" Binding="{Binding CredentialReference}" Width="1.4*"/><DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="IP"><DataGrid x:Name="IpGrid" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" Width="1.2*"/><DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="1.5*"/><DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.3*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="ASSIGNED" Binding="{Binding AssignedOn}" Width="110"/><DataGridTextColumn Header="RELEASED" Binding="{Binding ReleasedOn}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Website"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,10"><WrapPanel><Button Content="Open selected website" Style="{StaticResource PrimaryButtonStyle}" Width="158" Height="38" Margin="0,0,12,0" Click="OpenWebsiteButton_Click"/><TextBlock Text="Only the approved hostname is recorded for company-assigned website launches." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel></Border><DataGrid Grid.Row="1" x:Name="WebsiteGrid"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*"/><DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*"/><DataGridTextColumn Header="ACCESS" Binding="{Binding AccessLevel}" Width="90"/><DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></Grid></TabItem>
              </TabControl>
            </Border>
          </Grid>
        </TabItem>

        <!-- PRIVACY -->
        <TabItem Header="▣  Privacy">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="28,4,4,18">
              <TextBlock Text="Transparency &amp; privacy" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Clear boundaries for what the employee client does and does not collect." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                  <StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#EFF6FF" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Visible to authorized administrators" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Presence, last-seen and attendance-derived work state are synchronized while you are signed in.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Foreground application activity is sent only for administrator-approved application rules, and window titles only when that rule explicitly enables them.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Approved business website activity is recorded as hostname only.</TextBlock></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                  <StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF3" HorizontalAlignment="Left"><TextBlock Text="—" Foreground="#039855" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Never collected by this client" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">No keystrokes, passwords, screenshots, microphone audio, camera video or unrelated personal files are collected.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Browser history, URL paths, query strings, page content, form fields, cookies and survey answers are not read by this app.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">RDP and website passwords are not stored or displayed here.</TextBlock></StackPanel>
                </Border>
              </Grid>

              <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16" Padding="17" Margin="0,0,0,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Current monitoring disclosure" Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="MonitoringDisclosureText" Margin="0,8,20,0" TextWrapping="Wrap" Foreground="#334155" Text="Monitoring disclosure is loaded from the company server after sign-in."/></StackPanel><Button Grid.Column="1" Content="Refresh policy" Width="118" Height="38" VerticalAlignment="Center" Click="RefreshMonitoringPolicyButton_Click"/></Grid>
              </Border>

              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Assigned work and survey boundaries" FontSize="16" FontWeight="SemiBold"/><TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Website Work records when you start/open an assigned target and when you explicitly mark it complete. The client does not inspect the external page or credentials.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">Opening a survey assignment records that the approved survey link was opened using hostname-only audit metadata. Survey questions and answers remain on the external survey website.</TextBlock></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- STATUS -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1,1,1,0" Padding="12,8">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="MessageText" Text="Ready. Sign in to connect your workspace." TextWrapping="Wrap" Foreground="#475467" FontSize="11"/></Grid>
    </Border>
  </Grid>
</Window>