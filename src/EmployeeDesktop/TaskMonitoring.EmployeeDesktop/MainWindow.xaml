<Window x:Class="TaskMonitoring.EmployeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitoring · Employee Workspace"
        Height="820" Width="1320" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- SIGN IN -->
    <ScrollViewer x:Name="LoginShell" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28" MinHeight="560">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*" MinWidth="420" />
          <ColumnDefinition Width="0.85*" MinWidth="390" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="26" Padding="44">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#071426" Offset="0" />
              <GradientStop Color="#123A74" Offset="0.62" />
              <GradientStop Color="#4F46E5" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="48" Height="48" CornerRadius="14" Background="#3578F6">
                <TextBlock Text="TM" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="14,3,0,0">
                <TextBlock Text="TaskMonitoring" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="Employee workspace" Foreground="#B8C9E6" FontSize="11.5" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="540" HorizontalAlignment="Left">
              <Border Background="#173B67" CornerRadius="16" Padding="11,6" HorizontalAlignment="Left" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Text="Secure organization workspace" Foreground="#DCEBFF" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
              </Border>
              <TextBlock Text="One place for your workday." Foreground="White" FontSize="34" FontWeight="SemiBold" />
              <TextBlock Text="Attendance, assigned work, notifications and company access—organized in one focused desktop workspace."
                         Foreground="#C5D3E8" FontSize="13.5" TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,0" />
              <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#183B67" CornerRadius="15" Padding="15" Margin="0,0,7,0">
                  <StackPanel>
                    <TextBlock Text="WORK" Foreground="#7DD3FC" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Tasks + attendance" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="Daily actions stay visible and easy to reach." Foreground="#B7C8E1" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#183B67" CornerRadius="15" Padding="15" Margin="7,0,0,0">
                  <StackPanel>
                    <TextBlock Text="PRIVACY" Foreground="#86EFAC" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Transparent by design" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="Monitoring scope is visible and policy-controlled." Foreground="#B7C8E1" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="TaskMonitoring · employee client" Foreground="#8095B6" FontSize="11" />
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="14,0,0,0">
          <Border MaxWidth="440" Style="{StaticResource ElevatedCardStyle}" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="↗" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Sign in to your workspace" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,0" />
              <TextBlock Text="Use your organization account to open assigned work, attendance and company resources."
                         Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,20" />
              <TextBlock Text="SERVER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <TextBox x:Name="ServerUrlBox" Text="http://127.0.0.1:5080" Margin="0,5,0,13" ToolTip="Your organization server address" />
              <TextBlock Text="EMAIL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <TextBox x:Name="EmailBox" Margin="0,5,0,13" />
              <TextBlock Text="PASSWORD" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <PasswordBox x:Name="PasswordBox" Margin="0,5,0,18" />
              <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Height="46" Click="LoginButton_Click" />
              <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="#12B76A" Margin="0,4,8,0" VerticalAlignment="Top" />
                  <TextBlock Text="Session tokens stay in memory and are not written to plaintext files or logs." Foreground="#667085" FontSize="10.8" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- WORKSPACE -->
    <Grid x:Name="WorkspaceShell" Grid.Row="0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="82" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="13">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38BDF8" Offset="0" />
                    <GradientStop Color="#4F46E5" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="TM" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="12,2,0,0">
                <TextBlock Text="TaskMonitoring" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Employee command center" Foreground="#89A0C2" FontSize="10.5" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
            <Border Background="#0D1B31" BorderBrush="#1D3557" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="WORKSPACE" Foreground="#6F86A8" FontSize="9.5" FontWeight="Bold" />
                <TextBlock Text="Your daily work tools" Foreground="#D9E6F8" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Background="#0E1E36" BorderBrush="#223B60" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="Connected workspace" Foreground="#D8E4F3" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Presence sync runs while signed in" Foreground="#8195B4" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Transparent monitoring · privacy first" Foreground="#667B9C" FontSize="9.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE4F0" BorderThickness="0,0,0,1">
        <Grid Margin="26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Employee Command Center" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Attendance, assigned work, notifications and organization access in one place."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#ECFDF3" BorderBrush="#D1FADF" BorderThickness="1" CornerRadius="18" Padding="11,6" Margin="0,0,9,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#12B76A" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Online" Foreground="#027A48" FontWeight="SemiBold" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="18" Padding="11,6" Margin="0,0,9,0">
              <TextBlock x:Name="SessionIdentityText" Text="Employee session" Foreground="#475467" FontWeight="SemiBold" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button x:Name="LogoutButton" Content="Sign out" Width="92" Height="38" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Click="LogoutButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="18,16,24,18">
        <TabControl.Resources>
          <Style TargetType="TabItem" BasedOn="{StaticResource NavTabItemStyle}" />
        </TabControl.Resources>

        <TabItem Header="●  Attendance">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,2,4,10">
              <Border CornerRadius="22" Padding="24" Margin="0,0,0,16">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F2B52" Offset="0" />
                    <GradientStop Color="#2456B8" Offset="0.63" />
                    <GradientStop Color="#5B4CE6" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="TODAY" Foreground="#9ED8FF" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Your work session at a glance" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Text="Check in, manage breaks and keep your work state synchronized with the organization server."
                               Foreground="#D5E5FF" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="680" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#1FFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="#6EE7B7" Margin="0,0,7,0" VerticalAlignment="Center" />
                      <TextBlock Text="LIVE SESSION" Foreground="White" FontWeight="Bold" FontSize="10" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Padding="18" Margin="0,0,8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="38" Height="38" CornerRadius="11" Background="#ECFDF3" Margin="0,0,11,0">
                        <TextBlock Text="✓" Foreground="#039855" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Attendance" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Server validated" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AttendanceStatusText" Text="Sign in to load your attendance status." TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" LineHeight="18" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" Margin="8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="38" Height="38" CornerRadius="11" Background="#EFF6FF" Margin="0,0,11,0">
                        <TextBlock Text="↔" Foreground="#2563EB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Connection" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionStatusText" Text="Server: not connected" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock x:Name="RealtimeStatusText" Text="Notifications: disconnected" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" Margin="8,0,0,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="38" Height="38" CornerRadius="11" Background="#F5F3FF" Margin="0,0,11,0">
                        <TextBlock Text="◈" Foreground="#6D5CE7" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Monitoring" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MonitoringStatusText" Text="Approved activity monitoring: sign in to load policy" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11.5" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.45*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Padding="22" Margin="0,0,9,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Quick attendance actions" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Use the actions below to keep your work session accurate." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Refresh" Width="90" Height="36" Click="RefreshAttendanceButton_Click" />
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,18,0,0">
                      <Button Content="Check in" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0" Click="CheckInButton_Click" />
                      <Button Content="Start break" Margin="6,0" Click="StartBreakButton_Click" />
                      <Button Content="End break" Margin="6,0" Click="EndBreakButton_Click" />
                      <Button Content="Check out" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" Click="CheckOutButton_Click" />
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="9,0,0,0">
                  <StackPanel>
                    <TextBlock Text="Privacy-aware monitoring" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Only organization-approved activity rules are synchronized. Monitoring scope is disclosed in Privacy."
                               Foreground="#475467" FontSize="11.5" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,14,0,0">
                      <TextBlock Text="No keystrokes, passwords, screenshots, microphone or camera capture." Foreground="#334155" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="☷  My Tasks">
          <Grid Margin="24,2,4,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="My assigned tasks" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Project work, priority, due dates and discussion activity in one queue." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><CheckBox x:Name="IncludeClosedTasksBox" Content="Include done/cancelled" /></Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12">
              <Grid><TextBlock Text="Select a task row to review its status and project context." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><Button Content="Refresh tasks" Width="110" Height="36" HorizontalAlignment="Right" Click="RefreshTasksButton_Click"/></Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="TasksGrid"><DataGrid.Columns><DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.3*"/><DataGridTextColumn Header="TASK" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="100"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="110"/><DataGridTextColumn Header="COMMENTS" Binding="{Binding CommentCount}" Width="90"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <TabItem Header="◎  Website Work">
          <Grid Margin="24,2,4,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Website work queue" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Open approved work targets and mark them complete when assigned work is finished." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="WebsiteWorkCountText" Text="0 website work item(s)" Foreground="#1D4ED8" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh work" Width="104" Height="36" Margin="0,0,7,0" Click="RefreshWebsiteWorkButton_Click"/><Button Content="Start / Open selected" Style="{StaticResource PrimaryButtonStyle}" Width="154" Height="36" Margin="0,0,7,0" Click="OpenWebsiteWorkButton_Click"/><Button Content="Mark complete" Style="{StaticResource SuccessButtonStyle}" Width="122" Height="36" Margin="0,0,12,0" Click="CompleteWebsiteWorkButton_Click"/><CheckBox x:Name="IncludeClosedWebsiteWorkBox" Content="Include completed/cancelled"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="WebsiteWorkGrid"><DataGrid.Columns><DataGridTextColumn Header="TARGET" Binding="{Binding Title}" Width="1.7*"/><DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2*"/><DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="95"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105"/><DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <TabItem Header="◈  Survey Work">
          <Grid Margin="24,2,4,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Survey assignments" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Launch organization-assigned surveys without collecting form content or answers in this app." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="SurveyCountText" Text="0 survey assignment(s)" Foreground="#6D28D9" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh surveys" Width="114" Height="36" Margin="0,0,7,0" Click="RefreshSurveysButton_Click"/><Button Content="Open selected survey" Style="{StaticResource PrimaryButtonStyle}" Width="154" Height="36" Margin="0,0,12,0" Click="OpenSurveyButton_Click"/><CheckBox x:Name="IncludeInactiveSurveysBox" Content="Include inactive history"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="SurveyGrid"><DataGrid.Columns><DataGridTextColumn Header="SURVEY" Binding="{Binding Title}" Width="1.3*"/><DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2.2*"/><DataGridTextColumn Header="STARTS" Binding="{Binding StartsOn}" Width="105"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105"/><DataGridTextColumn Header="STATUS" Binding="{Binding Availability}" Width="95"/><DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <TabItem Header="◉  Notifications">
          <Grid Margin="24,2,4,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notifications" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Realtime organization updates and work-related messages." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#ECFDF3" BorderBrush="#D1FADF" BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="NotificationsCountText" Text="0 notifications" Foreground="#027A48" FontWeight="SemiBold"/></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh" Width="88" Height="36" Margin="0,0,7,0" Click="RefreshNotificationsButton_Click"/><Button Content="Mark selected read" Style="{StaticResource PrimaryButtonStyle}" Width="144" Height="36" Margin="0,0,12,0" Click="MarkNotificationReadButton_Click"/><CheckBox x:Name="UnreadNotificationsOnlyBox" Content="Unread only"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0"><DataGrid x:Name="NotificationsGrid"><DataGrid.Columns><DataGridTextColumn Header="STATE" Binding="{Binding ReadState}" Width="80"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="130"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.2*"/><DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.5*"/><DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc}" Width="170"/><DataGridTextColumn Header="READ" Binding="{Binding ReadAtUtc}" Width="170"/></DataGrid.Columns></DataGrid></Border>
          </Grid>
        </TabItem>

        <TabItem Header="◆  My Access">
          <Grid Margin="24,2,4,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="Company-provided access" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="View assigned RDP, IP and website access without exposing managed passwords inside this client." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12"><WrapPanel><Button Content="Refresh access" Width="110" Height="36" Margin="0,0,11,0" Click="RefreshAccessButton_Click"/><CheckBox x:Name="IncludeInactiveAccessBox" Content="Include inactive/released history"/></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="14"><TabControl TabStripPlacement="Top"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SubTabItemStyle}"/></TabControl.Resources><TabItem Header="RDP"><DataGrid x:Name="RdpGrid" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="1.4*"/><DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="70"/><DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*"/><DataGridTextColumn Header="CREDENTIAL REFERENCE" Binding="{Binding CredentialReference}" Width="1.4*"/><DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="IP"><DataGrid x:Name="IpGrid" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" Width="1.2*"/><DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="1.5*"/><DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.3*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="ASSIGNED" Binding="{Binding AssignedOn}" Width="110"/><DataGridTextColumn Header="RELEASED" Binding="{Binding ReleasedOn}" Width="110"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Website"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10"><WrapPanel><Button Content="Open selected website" Style="{StaticResource PrimaryButtonStyle}" Width="154" Height="36" Margin="0,0,11,0" Click="OpenWebsiteButton_Click"/><TextBlock Text="Only the approved hostname is recorded for company-assigned website launches." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel></Border><DataGrid Grid.Row="1" x:Name="WebsiteGrid"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*"/><DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*"/><DataGridTextColumn Header="ACCESS" Binding="{Binding AccessLevel}" Width="90"/><DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl></Border>
          </Grid>
        </TabItem>

        <TabItem Header="▣  Privacy">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,2,4,10">
              <TextBlock Text="Transparency &amp; privacy" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Clear boundaries for what the employee client does and does not collect." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,15" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ElevatedCardStyle}" Margin="0,0,8,12"><StackPanel><Border Width="40" Height="40" CornerRadius="12" Background="#EFF6FF" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Visible to authorized administrators" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Presence, last-seen and attendance-derived work state are synchronized while you are signed in.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Foreground application activity is sent only for administrator-approved application rules, and window titles only when that rule explicitly enables them.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Approved business website activity is recorded as hostname only.</TextBlock></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource ElevatedCardStyle}" Margin="8,0,0,12"><StackPanel><Border Width="40" Height="40" CornerRadius="12" Background="#ECFDF3" HorizontalAlignment="Left"><TextBlock Text="—" Foreground="#039855" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Never collected by this client" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">No keystrokes, passwords, screenshots, microphone audio, camera video or unrelated personal files are collected.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Browser history, URL paths, query strings, page content, form fields, cookies and survey answers are not read by this app.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">RDP and website passwords are not stored or displayed here.</TextBlock></StackPanel></Border>
              </Grid>
              <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="15" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Current monitoring disclosure" Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="MonitoringDisclosureText" Margin="0,7,18,0" TextWrapping="Wrap" Foreground="#334155" Text="Monitoring disclosure is loaded from the company server after sign-in."/></StackPanel><Button Grid.Column="1" Content="Refresh policy" Width="116" Height="36" VerticalAlignment="Center" Click="RefreshMonitoringPolicyButton_Click"/></Grid></Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Assigned work and survey boundaries" FontSize="15" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Website Work records when you start/open an assigned target and when you explicitly mark it complete. The client does not inspect the external page or credentials.</TextBlock><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="18">Opening a survey assignment records that the approved survey link was opened using hostname-only audit metadata. Survey questions and answers remain on the external survey website.</TextBlock></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DCE4F0" BorderThickness="1,1,1,0" Padding="12,8">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="MessageText" Text="Ready. Sign in to connect your workspace." TextWrapping="Wrap" Foreground="#475467" FontSize="11"/></Grid>
    </Border>
  </Grid>
</Window>