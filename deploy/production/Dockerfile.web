FROM node:24-bookworm-slim AS build
WORKDIR /src

COPY src/AdminWeb/package.json src/AdminWeb/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/AdminWeb/ ./
RUN npm run build

FROM caddy:2-alpine AS final
COPY deploy/production/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist/ /srv/admin/
RUN mkdir -p /srv/updates
EXPOSE 80 443
