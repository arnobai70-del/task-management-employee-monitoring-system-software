<Application x:Class="TaskMonitoring.EmployeeDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Signature workspace palette -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F8FAFF" Offset="0" />
      <GradientStop Color="#EEF4FF" Offset="0.48" />
      <GradientStop Color="#F7F9FC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFFF" Offset="0" />
      <GradientStop Color="#F8FBFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TableHeaderBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FBFDFF" Offset="0" />
      <GradientStop Color="#F1F6FC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LineBrush" Color="#D9E4F2" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#255BD3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF5FF" />
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#061120" Offset="0" />
      <GradientStop Color="#0A1D35" Offset="0.58" />
      <GradientStop Color="#102B4D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#3B82F6" Offset="0" />
      <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#10B981" Offset="0" />
      <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EF4444" Offset="0" />
      <GradientStop Color="#DC2626" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelectedBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2F6FED" Offset="0" />
      <GradientStop Color="#5B5CE2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#039855" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" Direction="270" ShadowDepth="7" Opacity="0.12" Color="#193B68" />
    <DropShadowEffect x:Key="NavGlow" BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.30" Color="#2F6FED" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="#D7E4F4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- DPI-safe text input. The content host is vertically centered instead of using
         top/bottom margins, which avoids glyph clipping at 125%/150% Windows scaling. -->
    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#C9D7E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="InputBorder" Property="Background" Value="#F8FAFC" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />

    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#C9D7E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="94" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#C9D7E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9CB4D0" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#6D8FF5" />
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{StaticResource SuccessGradientBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#34D399" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{StaticResource DangerGradientBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#F87171" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Signature sidebar navigation. The explicit TextBlock prevents the global
         foreground style from overriding nav text, while the accent rail, glow and
         end-cap marker give the employee client a recognizable visual identity. -->
    <Style x:Key="NavTabItemStyle" TargetType="TabItem">
      <Setter Property="Width" Value="204" />
      <Setter Property="Margin" Value="0,0,0,9" />
      <Setter Property="Padding" Value="13,12" />
      <Setter Property="Background" Value="#0D2440" />
      <Setter Property="Foreground" Value="#DCE8F8" />
      <Setter Property="BorderBrush" Value="#1B3B60" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ActiveMarker"
                        Width="4"
                        CornerRadius="3"
                        Background="#31557E"
                        HorizontalAlignment="Left"
                        Margin="0,1,0,1" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding Header}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center"
                           Margin="9,0,0,0" />
                <Border x:Name="EndCap"
                        Grid.Column="2"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="#355476"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#153455" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#315B87" />
                <Setter TargetName="ActiveMarker" Property="Background" Value="#60A5FA" />
                <Setter TargetName="EndCap" Property="Background" Value="#60A5FA" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8FB3FF" />
                <Setter TargetName="TabBorder" Property="Effect" Value="{StaticResource NavGlow}" />
                <Setter TargetName="ActiveMarker" Property="Background" Value="#FFFFFF" />
                <Setter TargetName="EndCap" Property="Background" Value="#C7D8FF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SubTabItemStyle" TargetType="TabItem">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="SubTabBorder" Background="#F8FBFF" BorderBrush="#D8E5F4" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <TextBlock Text="{TemplateBinding Header}"
                         Foreground="{TemplateBinding Foreground}"
                         FontWeight="{TemplateBinding FontWeight}"
                         VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SubTabBorder" Property="Background" Value="#F0F6FF" />
                <Setter Property="Foreground" Value="#334155" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SubTabBorder" Property="Background" Value="#EAF2FF" />
                <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#8FB3FF" />
                <Setter Property="Foreground" Value="#2456C8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E4F2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#EAF0F7" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="RowBackground" Value="#FFFFFF" />
      <Setter Property="AlternatingRowBackground" Value="#F8FBFF" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource TableHeaderBrush}" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#D8E4F2" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#334155" />
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="42" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F3F8FF" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E7F0FF" />
          <Setter Property="Foreground" Value="#2456C8" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>