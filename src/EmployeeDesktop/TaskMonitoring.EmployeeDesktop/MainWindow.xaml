<Window x:Class="TaskMonitoring.EmployeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitoring · Employee Workspace"
        Height="820" Width="1380" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="WorkspaceSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E1E7EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="TopNavItemStyle" TargetType="TabItem">
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="NavBackground"
                    Background="Transparent"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}"
                    Margin="0,5">
              <Grid>
                <TextBlock x:Name="NavText"
                           Text="{TemplateBinding Header}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <Border x:Name="Indicator"
                        Height="2"
                        Background="Transparent"
                        CornerRadius="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-5" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBackground" Property="Background" Value="#F1F4F8" />
                <Setter TargetName="NavText" Property="Foreground" Value="#25324A" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavBackground" Property="Background" Value="Transparent" />
                <Setter TargetName="NavText" Property="Foreground" Value="#1D4ED8" />
                <Setter TargetName="Indicator" Property="Background" Value="#2F6FED" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#FFFFFF"
                      BorderBrush="#E1E7EF"
                      BorderThickness="0,0,0,1">
                <TabPanel x:Name="HeaderPanel"
                          IsItemsHost="True"
                          Margin="20,0"
                          Background="Transparent"
                          VerticalAlignment="Stretch" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- SIGN IN -->
    <ScrollViewer x:Name="LoginShell"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <Grid MinHeight="560">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="24,24,12,24" CornerRadius="22" Padding="44">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0A1220" Offset="0" />
              <GradientStop Color="#142338" Offset="0.58" />
              <GradientStop Color="#193A55" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Border Width="48" Height="48" CornerRadius="13" Background="#2F6FED">
                <TextBlock Text="TM" Foreground="White" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="13,3,0,0">
                <TextBlock Text="TaskMonitoring" Foreground="White" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Text="Employee desktop" Foreground="#91A4BB" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="640">
              <TextBlock Text="One workspace for the workday."
                         Foreground="White" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="Attendance, assigned work, notifications and approved company access stay organized in one desktop app."
                         Foreground="#B7C5D6" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0" />
              <Border Background="#102B43" BorderBrush="#244760" BorderThickness="1"
                      CornerRadius="12" Padding="14" Margin="0,24,0,0">
                <TextBlock Text="Privacy boundary: no keystrokes, passwords, screenshots, microphone or camera capture."
                           Foreground="#D8E4F0" FontSize="11" TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="TaskMonitoring · organization workspace"
                       Foreground="#71869F" FontSize="10.5" />
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,24,24,24">
          <Border Style="{StaticResource ElevatedCardStyle}" Padding="32" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="EMPLOYEE SIGN IN" Foreground="#2F6FED" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="Open your workspace" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
              <TextBlock Text="Use your organization account to continue."
                         Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,5,0,22" />

              <TextBlock Text="EMAIL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <TextBox x:Name="EmailBox" Margin="0,5,0,14" />
              <TextBlock Text="PASSWORD" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <PasswordBox x:Name="PasswordBox" Margin="0,5,0,18" />
              <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}"
                      Height="46" Click="LoginButton_Click" />

              <Expander Header="Connection settings" Margin="0,18,0,0" Foreground="#475467">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="SERVER URL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBox x:Name="ServerUrlBox" Text="http://127.0.0.1:5080" Margin="0,5,0,0"
                           ToolTip="Your organization server address" />
                </StackPanel>
              </Expander>

              <TextBlock Text="Session tokens remain in memory and are not written to plaintext files or logs."
                         Foreground="#667085" FontSize="10.5" TextWrapping="Wrap" Margin="0,18,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- AUTHENTICATED WORKSPACE -->
    <Grid x:Name="WorkspaceShell" Grid.Row="0" Visibility="Collapsed" Background="#F3F5F8">
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- COMMAND BAR -->
      <Border Grid.Row="0" Background="#0B1320" BorderBrush="#1F2A38" BorderThickness="0,0,0,1">
        <Grid Margin="22,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="38" Height="38" CornerRadius="10" Background="#2F6FED">
              <TextBlock Text="TM" Foreground="White" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,1,0,0">
              <TextBlock Text="TaskMonitoring" Foreground="White" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Employee workspace" Foreground="#8194AA" FontSize="10" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Workday" Foreground="#E7EDF5" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Your work, status and company access in one place."
                       Foreground="#8294AA" FontSize="10.5" Margin="0,2,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
              <TextBlock Text="ONLINE" Foreground="#6EE7B7" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock x:Name="SessionIdentityText" Text="Employee session" Foreground="#DCE6F3"
                         FontSize="10.5" MaxWidth="190" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="LogoutButton" Content="Sign out" Width="88" Height="36"
                    Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Click="LogoutButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- FLAT TOP NAV + FULL-WIDTH CONTENT -->
      <TabControl Grid.Row="1"
                  Style="{StaticResource WorkspaceTabControlStyle}"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        <TabControl.Resources>
          <Style TargetType="TabItem" BasedOn="{StaticResource TopNavItemStyle}" />
        </TabControl.Resources>

        <!-- ATTENDANCE -->
        <TabItem Header="Attendance">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
            <Grid Margin="24,20,24,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" />
              </Grid.ColumnDefinitions>

              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="28">
                <StackPanel>
                  <TextBlock Text="TODAY · ATTENDANCE" Foreground="#2F6FED" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Current shift" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                  <TextBlock Text="Attendance state and actions stay together, without extra dashboard cards."
                             Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,5,0,22" />

                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                          CornerRadius="11" Padding="16">
                    <TextBlock x:Name="AttendanceStatusText"
                               Text="Sign in to load your attendance status."
                               TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" LineHeight="23" />
                  </Border>

                  <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Shift controls" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="Use explicit actions so your session stays accurate."
                                 Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" Width="90" Height="36"
                            Click="RefreshAttendanceButton_Click" />
                  </Grid>

                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Check in" Style="{StaticResource SuccessButtonStyle}"
                            Width="122" Height="44" Margin="0,0,10,10" Click="CheckInButton_Click" />
                    <Button Content="Start break" Width="122" Height="44"
                            Margin="0,0,10,10" Click="StartBreakButton_Click" />
                    <Button Content="End break" Width="122" Height="44"
                            Margin="0,0,10,10" Click="EndBreakButton_Click" />
                    <Button Content="Check out" Style="{StaticResource DangerButtonStyle}"
                            Width="122" Height="44" Margin="0,0,10,10" Click="CheckOutButton_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="24">
                <StackPanel>
                  <TextBlock Text="LIVE SYSTEM" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock x:Name="ConnectionStatusText" Text="Server: not connected"
                             FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                  <TextBlock x:Name="RealtimeStatusText" Text="Notifications: disconnected"
                             Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                             FontSize="10.5" Margin="0,6,0,0" />

                  <Border Height="1" Background="#E5EAF1" Margin="0,20,0,18" />

                  <TextBlock Text="Monitoring policy" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="MonitoringStatusText"
                             Text="Approved activity monitoring: sign in to load policy"
                             TextWrapping="Wrap" FontSize="10.8" LineHeight="17" Margin="0,9,0,0" />

                  <Border Background="#F0F7FF" BorderBrush="#D7E7FA" BorderThickness="1"
                          CornerRadius="10" Padding="11" Margin="0,18,0,0">
                    <TextBlock Text="No keystrokes, passwords, screenshots, microphone or camera capture."
                               Foreground="#3F5872" FontSize="10.2" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      Style="{StaticResource WorkspaceSurfaceStyle}" Padding="18" Margin="0,18,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WORKDAY FLOW" Foreground="#2F6FED" FontSize="9.5" FontWeight="Bold" />
                    <TextBlock Text="Three explicit steps" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="20,0,12,0">
                    <TextBlock Text="01  Check in" FontWeight="SemiBold" />
                    <TextBlock Text="Start the active work session." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="20,0,12,0">
                    <TextBlock Text="02  Manage breaks" FontWeight="SemiBold" />
                    <TextBlock Text="Start and end breaks explicitly." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="20,0,0,0">
                    <TextBlock Text="03  Check out" FontWeight="SemiBold" />
                    <TextBlock Text="Close the session when finished." Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- TASKS -->
        <TabItem Header="My Tasks">
          <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="My tasks" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Assigned work, priorities, due dates and discussion activity."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="IncludeClosedTasksBox"
                        Content="Include done/cancelled" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="12" Margin="0,0,0,12">
              <Grid>
                <TextBlock Text="Select a task row to review its current project context."
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Content="Refresh tasks" Width="112" Height="36" HorizontalAlignment="Right"
                        Click="RefreshTasksButton_Click" />
              </Grid>
            </Border>
            <DataGrid Grid.Row="2" x:Name="TasksGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.3*" />
                <DataGridTextColumn Header="TASK" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="100" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="110" />
                <DataGridTextColumn Header="COMMENTS" Binding="{Binding CommentCount}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- WEBSITE WORK -->
        <TabItem Header="Website Work">
          <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Website work" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Open approved work targets and mark them complete when finished."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="WebsiteWorkCountText"
                         Text="0 website work item(s)" Foreground="#475467" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh work" Width="106" Height="36" Margin="0,0,8,0"
                        Click="RefreshWebsiteWorkButton_Click" />
                <Button Content="Start / Open selected" Style="{StaticResource PrimaryButtonStyle}"
                        Width="158" Height="36" Margin="0,0,8,0" Click="OpenWebsiteWorkButton_Click" />
                <Button Content="Mark complete" Style="{StaticResource SuccessButtonStyle}"
                        Width="126" Height="36" Margin="0,0,14,0" Click="CompleteWebsiteWorkButton_Click" />
                <CheckBox x:Name="IncludeClosedWebsiteWorkBox" Content="Include completed/cancelled" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="WebsiteWorkGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="TARGET" Binding="{Binding Title}" Width="1.7*" />
                <DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2*" />
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="1.2*" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="95" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105" />
                <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- SURVEY WORK -->
        <TabItem Header="Survey Work">
          <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Survey work" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Launch organization-assigned surveys without collecting answers in this app."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="SurveyCountText"
                         Text="0 survey assignment(s)" Foreground="#475467" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh surveys" Width="116" Height="36" Margin="0,0,8,0"
                        Click="RefreshSurveysButton_Click" />
                <Button Content="Open selected survey" Style="{StaticResource PrimaryButtonStyle}"
                        Width="158" Height="36" Margin="0,0,14,0" Click="OpenSurveyButton_Click" />
                <CheckBox x:Name="IncludeInactiveSurveysBox" Content="Include inactive history" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="SurveyGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SURVEY" Binding="{Binding Title}" Width="1.3*" />
                <DataGridTextColumn Header="WEBSITE URL" Binding="{Binding Url}" Width="2.2*" />
                <DataGridTextColumn Header="STARTS" Binding="{Binding StartsOn}" Width="105" />
                <DataGridTextColumn Header="DUE" Binding="{Binding DueDate}" Width="105" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Availability}" Width="95" />
                <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- NOTIFICATIONS -->
        <TabItem Header="Notifications">
          <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Realtime organization updates and work-related messages."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="NotificationsCountText"
                         Text="0 notifications" Foreground="#475467" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh" Width="90" Height="36" Margin="0,0,8,0"
                        Click="RefreshNotificationsButton_Click" />
                <Button Content="Mark selected read" Style="{StaticResource PrimaryButtonStyle}"
                        Width="148" Height="36" Margin="0,0,14,0" Click="MarkNotificationReadButton_Click" />
                <CheckBox x:Name="UnreadNotificationsOnlyBox" Content="Unread only" />
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="2" x:Name="NotificationsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STATE" Binding="{Binding ReadState}" Width="80" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="130" />
                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.2*" />
                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.5*" />
                <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc}" Width="170" />
                <DataGridTextColumn Header="READ" Binding="{Binding ReadAtUtc}" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- MY ACCESS -->
        <TabItem Header="My Access">
          <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="My access" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="Company-provided RDP, IP and website access without exposing managed passwords."
                         Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="12" Margin="0,0,0,12">
              <WrapPanel>
                <Button Content="Refresh access" Width="112" Height="36" Margin="0,0,14,0"
                        Click="RefreshAccessButton_Click" />
                <CheckBox x:Name="IncludeInactiveAccessBox" Content="Include inactive/released history" />
              </WrapPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource WorkspaceSurfaceStyle}" Padding="14">
              <TabControl TabStripPlacement="Top" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                  <Style TargetType="TabItem" BasedOn="{StaticResource SubTabItemStyle}" />
                </TabControl.Resources>
                <TabItem Header="RDP">
                  <DataGrid x:Name="RdpGrid" Margin="0,12,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*" />
                      <DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="1.4*" />
                      <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="70" />
                      <DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*" />
                      <DataGridTextColumn Header="CREDENTIAL REFERENCE" Binding="{Binding CredentialReference}" Width="1.4*" />
                      <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110" />
                      <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="IP">
                  <DataGrid x:Name="IpGrid" Margin="0,12,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" Width="1.2*" />
                      <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="1.5*" />
                      <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.3*" />
                      <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                      <DataGridTextColumn Header="ASSIGNED" Binding="{Binding AssignedOn}" Width="110" />
                      <DataGridTextColumn Header="RELEASED" Binding="{Binding ReleasedOn}" Width="110" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="Website">
                  <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,10">
                      <WrapPanel>
                        <Button Content="Open selected website" Style="{StaticResource PrimaryButtonStyle}"
                                Width="158" Height="36" Margin="0,0,12,0" Click="OpenWebsiteButton_Click" />
                        <TextBlock Text="Only the approved hostname is recorded for company-assigned website launches."
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="WebsiteGrid">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                        <DataGridTextColumn Header="USERNAME REFERENCE" Binding="{Binding UsernameReference}" Width="1.2*" />
                        <DataGridTextColumn Header="ACCESS" Binding="{Binding AccessLevel}" Width="90" />
                        <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresOn}" Width="110" />
                        <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </TabItem>
              </TabControl>
            </Border>
          </Grid>
        </TabItem>

        <!-- PRIVACY -->
        <TabItem Header="Privacy">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
            <StackPanel Margin="24,20,24,18">
              <TextBlock Text="Privacy" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="Clear boundaries for what this employee client does and does not collect."
                         Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,16" />

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WorkspaceSurfaceStyle}">
                  <StackPanel>
                    <TextBlock Text="Visible to authorized administrators" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      Presence, last-seen and attendance-derived work state are synchronized while you are signed in.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      Foreground application activity is sent only for administrator-approved application rules, and window titles only when that rule explicitly enables them.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      Approved business website activity is recorded as hostname only.
                    </TextBlock>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WorkspaceSurfaceStyle}">
                  <StackPanel>
                    <TextBlock Text="Never collected by this client" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      No keystrokes, passwords, screenshots, microphone audio, camera video or unrelated personal files are collected.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      Browser history, URL paths, query strings, page content, form fields, cookies and survey answers are not read by this app.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                      RDP and website passwords are not stored or displayed here.
                    </TextBlock>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource WorkspaceSurfaceStyle}" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Current monitoring disclosure" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="MonitoringDisclosureText" Margin="0,8,20,0" TextWrapping="Wrap"
                               Foreground="#334155"
                               Text="Monitoring disclosure is loaded from the company server after sign-in." />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Refresh policy" Width="118" Height="36"
                          VerticalAlignment="Center" Click="RefreshMonitoringPolicyButton_Click" />
                </Grid>
              </Border>

              <Border Style="{StaticResource WorkspaceSurfaceStyle}">
                <StackPanel>
                  <TextBlock Text="Assigned work and survey boundaries" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                    Website Work records when you start/open an assigned target and when you explicitly mark it complete. The client does not inspect the external page or credentials.
                  </TextBlock>
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475467" LineHeight="19">
                    Opening a survey assignment records that the approved survey link was opened using hostname-only audit metadata. Survey questions and answers remain on the external survey website.
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- STATUS -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1,1,1,0" Padding="10,7">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="MessageText"
                   Text="Ready. Sign in to connect your workspace."
                   TextWrapping="Wrap" Foreground="#475467" FontSize="10.8"/>
      </Grid>
    </Border>
  </Grid>
</Window>
